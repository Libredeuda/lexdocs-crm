# ============================================================
# LexDocs / LibreApp — Variables de entorno
# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env (está en .gitignore).
# ============================================================

# ---- FRONTEND (Vite, prefijo VITE_) ------------------------
# Supabase (proyecto correspondiente al entorno)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Branding
VITE_APP_NAME=LexDocs

# Modo demo de producto: déjalo SIN definir (o false) en producción.
# Solo con VITE_DEMO_MODE=true se habilita el login de cuentas demo de cliente
# (maria@demo.com / empresa@demo.com) y se muestran credenciales de prueba.
# En producción NO debe estar activo (no se enviaría ninguna credencial al bundle).
# VITE_DEMO_MODE=false

# Stripe (clave publicable: pk_test_... en dev, pk_live_... en prod)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Anthropic: NO se usa desde el frontend. Carlota llama al Edge Function
# carlota-chat, que guarda la clave server-side (ANTHROPIC_API_KEY, más abajo).

# Web Push (clave PÚBLICA VAPID, base64url)
VITE_VAPID_PUBLIC_KEY=

# ============================================================
# SECRETS DE EDGE FUNCTIONS (Supabase)
# No van en .env local. Se configuran con:
#   supabase secrets set KEY=VALUE --project-ref <ref>
# Se listan aquí solo como referencia.
# ============================================================

# ---- Supabase (automático en Edge Functions, no hace falta setearlos) ----
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY

# ---- Anthropic (Carlota, ai-agent-respond, automation-runner, verify-document, ai-lead-scorer) ----
ANTHROPIC_API_KEY=sk-ant-xxx

# ---- Resend (email transaccional) ----
RESEND_API_KEY=re_xxx
FROM_EMAIL=LibreApp <noreply@libredeudaabogados.com>

# ---- Stripe (clave SECRETA + webhook) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- WhatsApp Business Cloud API (app de Meta "LexDocs") ----
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_ASSIGNMENT=case_assignment
WHATSAPP_TEMPLATE_MESSAGE=new_message
# App Secret de la app "LexDocs" (Settings → Basic → App Secret). Imprescindible
# en producción: valida la firma HMAC-SHA256 que Meta incluye en cada POST del
# webhook (X-Hub-Signature-256). Sin él, los webhooks aceptan tráfico sin verificar origen.
META_APP_SECRET=

# ---- Meta Ads (webhook de leads, app de Meta separada "LexDocs Leads") ----
# Meta no permite combinar "API de marketing" y "WhatsApp" en la misma app,
# así que esta app y sus secretos son distintos de los de arriba.
META_VERIFY_TOKEN=libreapp_meta_2026
META_PAGE_ACCESS_TOKEN=
META_LEADS_APP_SECRET=

# ---- Web Push VAPID ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@libredeudaabogados.com

# ---- Google Calendar OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/gcal-oauth-callback

# ---- URL de la app (para enlaces en emails, redirects, etc.) ----
APP_URL=https://app.libredeudaabogados.com

# ---- Secrets internos de Edge Functions ----
# Protege el modo cron de automation-runner (cabecera X-Cron-Secret).
# Sin él, cualquiera podría disparar el procesamiento de runs.
CRON_SECRET=

# Protege llamadas entre Edge Functions (cabecera X-Internal-Secret) y
# webhooks internos que invocan ai-agent-respond u otras funciones sin
# sesión de usuario.
INTERNAL_FUNCTION_SECRET=

# Escape hatch SOLO para desarrollo local. Por defecto (sin esta variable o
# distinto de "true"), si falta el secreto de firma (STRIPE_WEBHOOK_SECRET /
# META_APP_SECRET) los webhooks se RECHAZAN en vez de aceptarse sin verificar.
# NUNCA lo pongas a "true" en producción.
ALLOW_INSECURE_WEBHOOKS=
